# Docker compose internal DB (optional; defaults hanqing/hanqing/hanqing,
# first init of the pgdata volume only)
POSTGRES_USER=hanqing
POSTGRES_PASSWORD=hanqing
POSTGRES_DB=hanqing

# Database
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgresql.lan/${POSTGRES_DB}
HANQING__DATABASE__URL=${DATABASE_URL}

# Telegram API credentials from https://my.telegram.org/apps
HANQING__TELEGRAM__API_ID=
HANQING__TELEGRAM__API_HASH=

# S3 (media storage)
HANQING__S3__ENDPOINT=
HANQING__S3__BUCKET=
HANQING__S3__REGION=
HANQING__S3__ACCESS_KEY_ID=
HANQING__S3__SECRET_ACCESS_KEY=

# Logging
RUST_LOG=info,hanqing=debug
