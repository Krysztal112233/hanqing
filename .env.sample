# Internal PostgreSQL: required with compose.yaml (first init of pgdata only)
POSTGRES_USER=hanqing
POSTGRES_PASSWORD=hanqing
POSTGRES_DB=hanqing

# Host CLI with external PostgreSQL (full URL; no variable expansion):
# HANQING__DATABASE__URL=postgres://user:password@postgresql.lan/hanqing

# Telegram API credentials from https://my.telegram.org/apps
HANQING__TELEGRAM__API_ID=
HANQING__TELEGRAM__API_HASH=

# S3 (media storage)
HANQING__S3__ENDPOINT=
HANQING__S3__BUCKET=
HANQING__S3__REGION=
HANQING__S3__ACCESS_KEY_ID=
HANQING__S3__SECRET_ACCESS_KEY=

# Logging
RUST_LOG=info,hanqing=debug

# Only for a local compose.runtime.yaml (existing external PostgreSQL + model):
# HANQING_DB_IP=192.0.2.10
# HANQING_MODEL_DIR=/home/you/.local/share/hanqing/models
